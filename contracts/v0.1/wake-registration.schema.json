{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "apns-ptt"
        },
        "channelId": {
          "type": "string",
          "format": "uuid"
        },
        "environment": {
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "token": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1024,
          "pattern": "^(?:[0-9a-fA-F]{2})+$"
        }
      },
      "required": [
        "provider",
        "channelId",
        "environment",
        "token"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "none"
        }
      },
      "required": [
        "provider"
      ]
    }
  ]
}
